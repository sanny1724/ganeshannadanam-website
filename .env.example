# ==============================================================================
# CareerGraph - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# CognoDB (Graph Database Layer - Powered by openCypher & Bolt Protocol)
# Provide your CognoDB cloud instance credentials below.
# If left empty, CareerGraph will automatically run in local in-memory graph mode.
COGNODB_URI=bolt+s://your-instance.cognodb.io:7687
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your-secure-cognodb-password
COGNODB_DATABASE=neo4j

# Demo Mode Override (Set to 'true' to force local in-memory graph engine)
USE_IN_MEMORY_DEMO=false
