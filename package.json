{
  "name": "ai-desktop-assistant",
  "version": "1.0.0",
  "description": "AI Desktop Assistant — Autonomous Job Hunter Bot & Intelligent Email Monitor for Laptop",
  "main": "server/dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start": "cd server && npm start",
    "startup:enable": "node scripts/register-windows-startup.js",
    "startup:disable": "node scripts/unregister-windows-startup.js"
  },
  "keywords": [
    "ai-agent",
    "job-automation",
    "email-monitor",
    "windows-notifications",
    "copilot",
    "playwright"
  ],
  "author": "AI Desktop Assistant",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
